# Environment & Demo settings
DEMO_MODE=1
ENVIRONMENT=development

# LLM Backend: "framework" (universal adapter / local) or "direct" (external API keys)
LLM_BACKEND=framework
FRAMEWORK_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Direct API Keys (Required only if LLM_BACKEND=direct or running live external feeds)
OPENAI_API_KEY=
SARVAM_API_KEY=
TOMTOM_API_KEY=
TELEGRAM_BOT_TOKEN=

# Database
DATABASE_URL=sqlite:///./data/namma_twin.db

# Observability (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
